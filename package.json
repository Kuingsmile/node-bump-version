{
  "name": "node-bump-version",
  "version": "2.0.0",
  "description": "Preview and automate Node.js version bumps, changelogs, release commits, and Git tags.",
  "homepage": "https://github.com/Kuingsmile/node-bump-version#readme",
  "bugs": {
    "url": "https://github.com/Kuingsmile/node-bump-version/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuingsmile/node-bump-version.git"
  },
  "license": "MIT",
  "author": "Kuingsmile",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bump-version": "./dist/bin/bump-version.js"
  },
  "scripts": {
    "build": "rollup -c --forceExit",
    "clean": "rimraf dist",
    "cz": "git-cz",
    "dev": "rollup -c --watch",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "prepare": "husky",
    "prepublishOnly": "yarn run clean && yarn run build",
    "release": "yarn run build && node ./dist/bin/bump-version.js",
    "reproduce:bugs": "node scripts/reproduce-bugs.mjs",
    "pretest": "yarn run build",
    "test": "node --test",
    "test:package": "node scripts/check-package.mjs",
    "test:regressions": "node scripts/reproduce-bugs.mjs --verify-fixed",
    "typecheck": "tsc --noEmit"
  },
  "commitlint": {
    "extends": [
      "./dist/commitlint-node/index.js"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-writer": "^9.2.1",
    "conventional-commits-parser": "^7.1.2",
    "inquirer": "^14.2.2",
    "ora": "^9.4.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.2",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./commitlint": {
      "types": "./dist/commitlint-node/index.d.ts",
      "default": "./dist/commitlint-node/index.js"
    },
    "./commitlint/conventional": {
      "types": "./dist/commitlint-standard/index.d.ts",
      "default": "./dist/commitlint-standard/index.js"
    },
    "./changelog": {
      "types": "./dist/conventional-changelog-node/index.d.ts",
      "default": "./dist/conventional-changelog-node/index.js"
    },
    "./changelog/conventional": {
      "types": "./dist/conventional-changelog-standard/index.d.ts",
      "default": "./dist/conventional-changelog-standard/index.js"
    },
    "./commitizen": "./.cz-config.cjs",
    "./commitizen/conventional": "./.cz-config-conventional.cjs",
    "./package.json": "./package.json",
    "./.cz-config.cjs": "./.cz-config.cjs",
    "./dist/*": "./dist/*"
  },
  "peerDependencies": {
    "@commitlint/cli": "^21.2.2",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "husky": "^9.1.7"
  },
  "peerDependenciesMeta": {
    "@commitlint/cli": {
      "optional": true
    },
    "commitizen": {
      "optional": true
    },
    "cz-customizable": {
      "optional": true
    },
    "husky": {
      "optional": true
    }
  },
  "files": [
    "dist/",
    ".cz-config.cjs",
    ".cz-config-conventional.cjs",
    "CHANGELOG.md"
  ],
  "keywords": [
    "release",
    "version",
    "changelog",
    "semver",
    "conventional-commits",
    "cli"
  ]
}
