{
  "name": "node-bump-version",
  "version": "2.0.0",
  "description": "",
  "homepage": "https://github.com/Kuingsmile/node-bump-version#readme",
  "bugs": {
    "url": "https://github.com/Kuingsmile/node-bump-version/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuingsmile/node-bump-version.git"
  },
  "license": "MIT",
  "author": "Kuingsmile",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bump-version": "./dist/bin/bump-version.js"
  },
  "scripts": {
    "build": "rollup -c",
    "clean": "rimraf dist",
    "cz": "git-cz",
    "dev": "rollup -c --watch",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "prepare": "husky",
    "prepublishOnly": "yarn run clean && yarn run build",
    "release": "yarn run build && node ./dist/bin/bump-version.js",
    "reproduce:bugs": "node scripts/reproduce-bugs.mjs",
    "pretest": "yarn run build",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "commitlint": {
    "extends": [
      "./dist/commitlint-node/index.js"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.2",
    "chalk": "^6.0.0",
    "commitizen": "^4.3.2",
    "conventional-changelog": "^8.1.3",
    "cz-customizable": "^7.5.4",
    "eslint-plugin-n": "^18.3.0",
    "husky": "^9.1.7",
    "inquirer": "^14.2.2",
    "lodash": "^4.18.1",
    "minimist": "^1.2.8",
    "ora": "^9.4.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/lodash": "^4.17.25",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.20.2",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
