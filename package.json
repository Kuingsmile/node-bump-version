{
  "name": "node-bump-version",
  "version": "3.0.0",
  "description": "Preview and automate Node.js version bumps, changelogs, release commits, and Git tags.",
  "keywords": [
    "release",
    "version",
    "changelog",
    "semver",
    "conventional-commits",
    "cli"
  ],
  "homepage": "https://github.com/Kuingsmile/node-bump-version#readme",
  "bugs": {
    "url": "https://github.com/Kuingsmile/node-bump-version/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuingsmile/node-bump-version.git"
  },
  "license": "MIT",
  "author": "Kuingsmile",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./commitlint": {
      "types": "./dist/commitlint-node/index.d.ts",
      "default": "./dist/commitlint-node/index.js"
    },
    "./commitlint/conventional": {
      "types": "./dist/commitlint-standard/index.d.ts",
      "default": "./dist/commitlint-standard/index.js"
    },
    "./changelog": {
      "types": "./dist/conventional-changelog-node/index.d.ts",
      "default": "./dist/conventional-changelog-node/index.js"
    },
    "./changelog/conventional": {
      "types": "./dist/conventional-changelog-standard/index.d.ts",
      "default": "./dist/conventional-changelog-standard/index.js"
    },
    "./commitizen": "./.cz-config.cjs",
    "./commitizen/conventional": "./.cz-config-conventional.cjs",
    "./package.json": "./package.json",
    "./.cz-config.cjs": "./.cz-config.cjs",
    "./dist/*": "./dist/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bump-version": "./dist/bin/bump-version.js"
  },
  "files": [
    "dist/",
    ".cz-config.cjs",
    ".cz-config-conventional.cjs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm run clean && rolldown -c && tsc --emitDeclarationOnly",
    "clean": "rimraf dist",
    "cz": "czg --config=.cz-config.cjs",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:js": "rolldown -c --watch",
    "dev:types": "tsc --emitDeclarationOnly --watch",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm run build && node ./dist/bin/bump-version.js",
    "reproduce:bugs": "node scripts/reproduce-bugs.mjs",
    "pretest": "pnpm run build",
    "test": "node --test",
    "test:package": "node scripts/check-package.mjs",
    "test:regressions": "node scripts/reproduce-bugs.mjs --verify-fixed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/confirm": "^5.1.21",
    "@inquirer/input": "^4.3.1",
    "@inquirer/select": "^4.4.2",
    "chalk": "^6.0.1",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-writer": "^9.3.0",
    "conventional-commits-parser": "^7.1.4",
    "ora": "^10.0.0",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "czg": "^1.14.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "rolldown": "^1.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "peerDependencies": {
    "@commitlint/cli": "^21.2.4",
    "czg": "^1.14.0",
    "husky": "^9.1.7"
  },
  "peerDependenciesMeta": {
    "@commitlint/cli": {
      "optional": true
    },
    "czg": {
      "optional": true
    },
    "husky": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
